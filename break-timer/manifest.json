{
  "manifest_version": 3,
  "name": "Break Timer",
  "version": "1.1.0",
  "description": "Keeps a healthy work/break rhythm: 45 minutes of work, 15 minutes of break (configurable).",
  "permissions": ["alarms", "notifications", "storage"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["common.js", "background.js"]
  },
  "action": {
    "default_title": "Break Timer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "break-timer@sebastiangolian"
    }
  }
}
